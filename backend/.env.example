# =====================================================================
# Echo API — environment variables
# Copy to backend/.env for local development:   cp .env.example .env
# NEVER commit the real .env file. In production set these in Render.
# =====================================================================

# --- Required --------------------------------------------------------
# Local development: a MongoDB running on your machine.
# Production: your MongoDB Atlas connection string (mongodb+srv://...).
MONGO_URI=mongodb://127.0.0.1:27017/echo

# Secret used to sign session cookies. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- Server ----------------------------------------------------------
PORT=5000
# development | production   (Render sets production via render.yaml)
NODE_ENV=development
# The frontend URL(s) allowed to call this API, comma-separated.
# Local: http://localhost:5173   Production: https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Number of proxies in front of the API (Render = 1). Used for rate limiting.
TRUST_PROXY=0
# Session length (jsonwebtoken format, e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# --- Session cookie --------------------------------------------------
# Keep "lax" when the frontend proxies /api (recommended, see README).
# Use "none" only if the frontend calls the API on another domain directly
# (VITE_API_URL set); that also requires COOKIE_SECURE=true and HTTPS.
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# --- Media storage ---------------------------------------------------
# gridfs     = photos & recordings stored in your MongoDB (no extra account)
# cloudinary = stored in Cloudinary as private "authenticated" assets
MEDIA_STORAGE=gridfs
MAX_IMAGE_MB=12
MAX_AUDIO_MB=15
# Only for MEDIA_STORAGE=cloudinary (Cloudinary dashboard -> API Keys):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=echo

# --- Optional AI features (all OFF when left empty) -------------------
# Any OpenAI-compatible API works. Each feature is configured separately.
# Set BASE_URL and MODEL together. Check your provider's current model
# names, prices and data-use policy before enabling (see README).
#
# Ask Echo answers + memory suggestions (chat completions):
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
AI_CHAT_MODEL=
# Semantic search (embeddings):
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
# Voice transcription (audio/transcriptions):
AI_TRANSCRIBE_BASE_URL=
AI_TRANSCRIBE_API_KEY=
AI_TRANSCRIBE_MODEL=
# AI_TIMEOUT_MS=45000
# AI_SEMANTIC_MIN_SCORE=0.3

# --- Rate limits (optional) -------------------------------------------
# RATE_LIMIT_AUTH=20       # login/register attempts per IP+email per 15 min
# RATE_LIMIT_AI=60         # AI requests per user per hour
# RATE_LIMIT_UPLOADS=300   # uploads per user per hour
# LOG_LEVEL=info           # debug | info | warn | error | silent

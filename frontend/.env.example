# Echo frontend — environment variables (Vite exposes only VITE_* to the browser;
# never put secrets here).

# Leave EMPTY (recommended). The app then calls /api on its own domain:
#   - in development Vite proxies /api to http://localhost:5000
#   - on Vercel, vercel.json rewrites /api to your Render backend
# Set it only to call a backend on another domain directly, e.g.
#   VITE_API_URL=https://echo-api.onrender.com
# (then the backend needs COOKIE_SAMESITE=none; Safari may block that cookie).
VITE_API_URL=

# Development only: where Vite proxies /api (default http://localhost:5000)
# DEV_API_PROXY=http://localhost:5000
